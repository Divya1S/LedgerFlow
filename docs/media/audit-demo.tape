# vhs tape for the README GIF: money moves, then the books are audited.
# Record: vhs docs/media/audit-demo.tape  (stack + app must be running)
Output docs/media/audit-demo.gif
Set FontSize 15
Set Width 1080
Set Height 660
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Type "./scripts/audit-demo.sh"
Enter
Sleep 14s
